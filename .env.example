# Bulk-IOC-Scanner — optional settings
#
# You do not need this file. API keys are normally added on the Settings page
# inside the app, and everything below has a sensible default.
#
# If you do want a file, copy it to your data directory as ".env":
#
#   Windows   %LOCALAPPDATA%\BulkIOCScanner\.env
#   macOS     ~/Library/Application Support/BulkIOCScanner/.env
#   Linux     ~/.local/share/bulk-ioc-scanner/.env
#
# Any of these can also be set as ordinary environment variables.
# Keys saved through the Settings page take precedence over keys set here.


# ── API keys (all optional; each source is skipped without one) ───────────────

# VirusTotal (v3) — hashes, IPs, domains, URLs — https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# AbuseIPDB (v2) — IP abuse reports — https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# GreyNoise Community — internet noise vs targeted — https://viz.greynoise.io/account/api-key
GREYNOISE_API_KEY=

# ThreatFox / abuse.ch — known malware indicators — https://auth.abuse.ch/
THREATFOX_AUTH_KEY=

# URLScan.io — existing scans of a URL — https://urlscan.io/user/profile/
URLSCAN_API_KEY=

# IPify Geolocation — IP geo and ASN — https://geo.ipify.org/docs
IPIFY_API_KEY=

# RDAP / WHOIS needs no key. It is on by default and covers domains, IPs, and
# CIDRs, which is why the tool is useful before you configure anything.


# ── Corporate networks ────────────────────────────────────────────────────────

# HTTP_PROXY / HTTPS_PROXY / NO_PROXY are honoured automatically. Set this only
# to force a specific proxy regardless of the environment.
# PROXY_URL=http://proxy.example.corp:8080

# CA bundle for networks that inspect TLS with their own certificate authority.
# If REQUESTS_CA_BUNDLE, SSL_CERT_FILE, or CURL_CA_BUNDLE is already set, it is
# used automatically and you can leave this blank.
# CA_BUNDLE=/path/to/corporate-ca.pem

# Last resort for a proxy whose certificate cannot be validated. Prefer
# CA_BUNDLE — with this on you cannot tell your proxy from an attacker.
# INSECURE_SKIP_VERIFY=false

# Raise these on slow or heavily filtered links.
# REQUEST_TIMEOUT_SECONDS=30
# CONNECT_TIMEOUT_SECONDS=10


# ── Limits and behaviour ──────────────────────────────────────────────────────

# Max single file upload size in MB
# MAX_UPLOAD_MB=1024

# Max indicators per scan request
# MAX_IOCS_PER_SCAN=200

# Reuse a stored result if the same indicator was scanned within this many hours
# CACHE_TTL_HOURS=24

# Requests per minute per source, tuned to the free tiers. Raise these only if
# your plan allows more; the defaults exist to keep you under the free limits.
# VT_RATE_PER_MIN=4
# ABUSEIPDB_RATE_PER_MIN=30
# GREYNOISE_RATE_PER_MIN=30
# THREATFOX_RATE_PER_MIN=60
# URLSCAN_RATE_PER_MIN=60
# IPIFY_RATE_PER_MIN=60


# ── Advanced ──────────────────────────────────────────────────────────────────

# Where the database and this file live. The command line --data-dir wins.
# BULK_IOC_SCANNER_DATA_DIR=/path/to/data

# Full SQLAlchemy URL, if you want the database somewhere specific.
# Defaults to bulk_ioc_scanner.db inside the data directory.
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/bulk_ioc_scanner.db

# Only needed when serving the interface from a different origin than the API,
# such as the Vite dev server. Empty means same-origin, and no CORS.
# FRONTEND_ORIGIN=http://localhost:5173
